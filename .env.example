# ============ DATABASE ============
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=bdd_gym_sync

# ============ JWT ============
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h

# ============ SERVER ============
PORT=3000
NODE_ENV=development

# ============ MIGRATION ============
# Activar SOLO la primera vez para recrear tablas desde cero.
# Después de la primera ejecución exitosa, cambiar a false o eliminar.
#cp .env.example .env
DROP_SCHEMA=false